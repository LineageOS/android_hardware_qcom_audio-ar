cc_library_shared {
    name: "libvolumelistener",
    defaults: ["aidlaudioeffectserviceqti_defaults"],
    owner: "qti",
    relative_install_path: "soundfx",
    vendor: true,

    tidy: true,

    cflags: [
        "-v",
        "-Wthread-safety",
    ],

    srcs: [
        "VolumeListener.cpp",
        "VolumeListenerContext.cpp",
        "GlobalVolumeListenerSession.cpp",
    ],

    shared_libs: [
        "libar-pal",
    ],

    static_libs: [
        "libaudioeffecthal_base_impl_static",
    ],
}
