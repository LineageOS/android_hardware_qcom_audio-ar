cc_fuzz {
    name: "aidl_fuzzer_audio_core_hal",
    defaults: [
        "latest_android_hardware_audio_core_ndk_shared",
        "latest_android_media_audio_common_types_ndk_shared",
    ],
    vendor: true,

    srcs: ["fuzzer.cpp"],

    shared_libs: [
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "libclang_rt.ubsan_standalone",
        "libcutils",
        "libhardware",
        "libutils",
    ],

    static_libs: ["libbinder_random_parcel"],
}
